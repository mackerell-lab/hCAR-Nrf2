! input file; use ! or # for skipping lines

#####################################################################
SILCS_RULES  /opt/silcsbio/apps/silcsbio/silcsbio.2025/data/silcs/silcs_classification_rules_2021_generic_apolar_scale_1f.dat
CGENFF_RULES /opt/silcsbio/apps/silcsbio/silcsbio.2025/data/cgenff/cgenff.rules
CGENFF_PAR   /opt/silcsbio/apps/silcsbio/silcsbio.2025/data/cgenff/par_all36_cgenff.prm
GFE_CAP  3.0

MINIMIZE_INPUT false
MINIMIZE_BFGS false
MIN_STEPS 10000

MC_MOVE_RANGE  1.0  180.0  180.0
MC_STEPS 10000
MC_RUN 1                       !  
MC_STEPS2 10000                !  
MC_MOVE_RANGE2  0.1  9.0  60.0 ! 

SIM_ANNEAL_MOVE_RANGE  0.2 9.0 9.0
SIM_ANNEAL_STEPS  40000

DELTAE_TOLERANCE 0.01
TOT_RUNS 1250
DELTA_LGFE_BUFF 10.0
SILCS_LGFE_NORMALIZE false
RANDOM_SEED true
#####################################################################

RANDOM_INIT_ORIENT true    ! false to use starting orientation
                           ! true to randomize orientation

SIMULATION_CENTER 0.27 4.75 -9.31
SIMULATION_RADIUS 10.0

!FORMAT OF SPECIFYING MAPS: SILCSMAP  <TYPE>  <FILENAME>
